<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Three explicit themes rather than relying on DayNight alone.
         DayNight follows the system, which is right as a default but
         does not let someone pick. setTheme + recreate switches
         between them, which needs no androidx dependency. -->
    <!-- DayNight so the first frame before onCreate applies the stored
         choice already follows the system. -->
    <style name="Theme.CapRustRemote" parent="@android:style/Theme.DeviceDefault.DayNight" />
    <style name="Theme.CapRustRemote.Light" parent="@android:style/Theme.DeviceDefault.Light" />
    <style name="Theme.CapRustRemote.Dark" parent="@android:style/Theme.DeviceDefault" />
</resources>